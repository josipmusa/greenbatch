#!/usr/bin/env bash
# Discovers available Maven updates as facts JSON, one element per *lever*.
# Side-effect free: it runs report-only goals and never edits a pom.
#
# Usage:  discover [repo-dir]
# Prints: facts JSON (see docs/adapters.md) on stdout
# Exit:   0 on success, 2 on tool failure
#
# Why "one element per lever" rather than per artifact: the property and
# dependency reports overlap. A library whose version is a ${property} reference
# appears in both, while a library carrying a literal <version> tag appears only
# in the dependency report. Property-controlled versions only move via
# set-property; literals only via use-dep-version. Applying the wrong mechanism
# changes nothing and exits 0, so the pom is parsed to resolve which lever
# controls each artifact, and the two reports are deduped accordingly.
set -euo pipefail

repo="${1:-.}"
cd "$repo"

VERSIONS_PLUGIN="${VERSIONS_PLUGIN:-org.codehaus.mojo:versions-maven-plugin:2.19.1}"
MVN="./mvnw"
[ -x "$MVN" ] || MVN="mvn"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

# The versions plugin happily offers release candidates as the newest version,
# and it offers only ONE - so an alpha does not merely add noise, it hides the
# stable release behind it. On this repository's own fixture, slf4j-api reported
# 2.0.0 -> 2.1.0-alpha1 (correctly flagged prerelease, correctly never applied)
# while stable 2.0.18 went unmentioned, and the report read as "up to date".
# Filtering at the source makes the plugin offer the newest STABLE version.
#
# `(?i)` is an inline Java regex flag; the property is a comma-separated list of
# patterns matched against the whole version. is_prerelease() below stays as a
# backstop for anything these miss.
#
# Tradeoff worth knowing: an artifact whose only newer version is a prerelease
# is now absent from the facts entirely rather than listed in the `prerelease`
# bucket. Surfacing both would mean running every goal twice, which doubles the
# slowest part of discovery to report something the run would never apply.
IGNORED_VERSIONS='(?i).*-alpha.*,(?i).*-beta.*,(?i).*-rc.*,(?i).*-cr.*,(?i).*-m[0-9]+,(?i).*-milestone.*,(?i).*-preview.*,(?i).*-snapshot.*,(?i).*\.rc[0-9]+,(?i).*\.m[0-9]+,(?i).*\.cr[0-9]+'

# What the root pom is: does it have a parent to bump, and is it an aggregator?
probe=$(python3 - pom.xml <<'PY'
import sys, xml.etree.ElementTree as ET

NS = {"m": "http://maven.apache.org/POM/4.0.0"}
root = ET.parse(sys.argv[1]).getroot()

print("parent=" + ("yes" if root.find("m:parent", NS) is not None else "no"))
print("modules=" + ",".join(m.text.strip() for m in root.findall("m:modules/m:module", NS) if m.text))
PY
) || { echo "maven/discover: could not read pom.xml" >&2; exit 2; }

# Keyed lines rather than positional ones: an empty modules list makes the second
# line blank, and positional parsing silently returns the first line for it.
has_parent=no
modules=
while IFS= read -r line; do
  case "$line" in
    parent=*) has_parent="${line#parent=}" ;;
    modules=*) modules="${line#modules=}" ;;
  esac
done <<EOF
$probe
EOF

# Multi-module: the goals run over the whole reactor, but only the root pom is
# parsed below to work out which lever controls each artifact. A child module's
# dependency therefore looks version-less and would be reported as
# `unmanageable` - "pinned by a parent or BOM" - which is confidently false. `-N`
# keeps the goals and the parse describing the same pom, and the caveat is
# reported rather than left for the reader to discover.
scope_args=()
if [ -n "$modules" ]; then
  scope_args=(-N)
fi

# The user property is `versions.outputFile`, NOT `outputFile`. With the wrong
# name these goals exit 0 and write nothing at all.
#
# processDependencyManagementTransitive=false keeps imported BOMs out of the
# dependency report - hundreds of managed versions this run has no lever for.
run_goal() {
  local goal="$1" out="$2"
  shift 2
  if ! "$MVN" -B -q "${VERSIONS_PLUGIN}:${goal}" \
    -Dversions.outputFile="$out" -Dmaven.version.ignore="$IGNORED_VERSIONS" \
    "${scope_args[@]}" "$@" >"$work/$goal.log" 2>&1; then
    echo "maven/discover: $goal failed:" >&2
    tail -20 "$work/$goal.log" >&2
    return 2
  fi
  : >>"$out"
}

run_goal display-property-updates "$work/props.txt"
run_goal display-dependency-updates "$work/deps.txt" \
  -DprocessDependencyManagementTransitive=false

# display-parent-updates errors out on a pom with no <parent>, which is a normal
# single-module layout rather than a failure. The probe above asked first.
: >"$work/parent.txt"
if [ "$has_parent" = "yes" ]; then
  run_goal display-parent-updates "$work/parent.txt"
fi

python3 - "$work/props.txt" "$work/parent.txt" "$work/deps.txt" pom.xml "$modules" <<'PY'
import json, re, sys
import xml.etree.ElementTree as ET

props_file, parent_file, deps_file, pom_file, modules_csv = sys.argv[1:6]
modules = [m for m in modules_csv.split(",") if m]

# The reports pad names with dot runs: "${archunit.version} ....... 1.4.2 -> 1.5.0"
UPDATE = re.compile(r"^\s*(?P<name>\S+)\s+(?P<from>[^\s>]+)\s*->\s*(?P<to>\S+)\s*$")


def parse_updates(path, strip_property_braces=False):
    found = {}
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except FileNotFoundError:
        return found
    for line in lines:
        if "->" not in line:
            continue
        collapsed = re.sub(r"\.{2,}", " ", line)
        m = UPDATE.match(collapsed)
        if not m:
            continue
        name = m.group("name")
        if strip_property_braces:
            pm = re.fullmatch(r"\$\{(.+)\}", name)
            if not pm:
                continue
            name = pm.group(1)
        found[name] = (m.group("from"), m.group("to"))
    return found


property_updates = parse_updates(props_file, strip_property_braces=True)
parent_updates = parse_updates(parent_file)
dependency_updates = parse_updates(deps_file)

# --- Maven's own versioning scheme, which only this adapter knows -------------


def bump(frm, to):
    """major | minor | patch | unknown, over Maven's dotted-and-qualified versions."""

    def numeric_prefix(v):
        parts = re.split(r"[.\-_]", str(v).strip())
        out = []
        for p in parts:
            if p.isdigit():
                out.append(int(p))
            else:
                break
        return out

    a, b = numeric_prefix(frm), numeric_prefix(to)
    if not a or not b:
        return "unknown"
    if a[0] != b[0]:
        return "major"
    if (a[1:2] or [0]) != (b[1:2] or [0]):
        return "minor"
    return "patch"


def is_prerelease(version):
    """RC, alpha, beta, milestone, snapshot - including Spring-style .RC1.

    The versions plugin happily offers release candidates, and a minor-looking
    one such as 1.3.0-rc1 would otherwise be applied in the tier-1 batch,
    adopting an RC nobody chose. A hyphen followed only by digits is build
    metadata (1.2.3-1), not a prerelease.
    """
    v = str(version or "").strip()
    return bool(
        re.search(r"-[^-]*[a-zA-Z]", v)
        or re.search(r"\.(?:rc|m|cr)\d+$", v, re.IGNORECASE)
        or re.search(r"snapshot", v, re.IGNORECASE)
    )


# --- what the pom actually declares, so we know which lever moves each artifact

NS = {"m": "http://maven.apache.org/POM/4.0.0"}


def text(node, tag):
    child = node.find(f"m:{tag}", NS)
    return child.text.strip() if child is not None and child.text else None


tree = ET.parse(pom_file)
root = tree.getroot()

declared = {}  # "groupId:artifactId" -> version string as written, or None if managed
for xpath in (
    "m:dependencies/m:dependency",
    "m:dependencyManagement/m:dependencies/m:dependency",
    "m:build/m:plugins/m:plugin",
    "m:build/m:pluginManagement/m:plugins/m:plugin",
):
    for node in root.findall(xpath, NS):
        group = text(node, "groupId")
        artifact = text(node, "artifactId")
        if not artifact:
            continue
        declared.setdefault(f"{group}:{artifact}", text(node, "version"))


def controlling_property(version):
    if not version:
        return None
    m = re.fullmatch(r"\$\{(.+)\}", version.strip())
    return m.group(1) if m else None


# property -> the artifacts whose version it controls
artifacts_by_property = {}
for ga, version in declared.items():
    prop = controlling_property(version)
    if prop:
        artifacts_by_property.setdefault(prop, []).append(ga)


def fact(element_id, name, frm, to, mechanism, **extra):
    return {
        "id": element_id,
        "name": name,
        "from": frm,
        "to": to,
        "bump": bump(frm, to),
        "prerelease": is_prerelease(to),
        "mechanism": mechanism,
        "family": None,  # Maven has no scope convention; explicit config groups still apply
        **extra,
    }


updates = []
unmanageable = []

for prop, (frm, to) in sorted(property_updates.items()):
    updates.append(
        fact(
            f"property:{prop}={to}",
            prop,
            frm,
            to,
            "property",
            artifacts=sorted(artifacts_by_property.get(prop, [])),
        )
    )

for ga, (frm, to) in sorted(dependency_updates.items()):
    version = declared.get(ga)
    prop = controlling_property(version)
    if prop is not None:
        # Already covered by its property element - reporting it again would
        # double-count the update and then apply the wrong mechanism.
        continue
    if version is None:
        # Declared with no <version>: the parent or an imported BOM pins it.
        # There is no lever short of overriding the BOM, which would fight the
        # parent's tested version set - so this is NOT an update the run can
        # make. It is still reported, because silently dropping it would read as
        # "up to date".
        unmanageable.append(
            {
                "name": ga,
                "from": frm,
                "to": to,
                "reason": "version managed by the parent or an imported BOM - moves when the parent moves",
            }
        )
        continue
    updates.append(fact(f"dependency:{ga}={to}", ga, frm, to, "dependency"))

for ga, (frm, to) in sorted(parent_updates.items()):
    # A parent bump moves a whole managed version set at once, so its blast
    # radius has nothing to do with how small the version step looks. `risky`
    # tells core to keep it out of the tier-1 batch whatever its bump says.
    updates.append(fact(f"parent={to}", ga, frm, to, "parent", risky=True))

# Caveats about the SCOPE of this discovery, as opposed to individual updates a
# run cannot make. A reader who is not told the child modules went unscanned
# reads the report as covering the whole project.
notes = []
if modules:
    notes.append(
        "multi-module project: discovery scanned the root pom only; "
        f"{len(modules)} child module(s) ({', '.join(sorted(modules))}) were not scanned. "
        "Dependencies declared in those modules are neither reported nor updated."
    )

# Maven has no lockfile and no transitive audit pass, so it declares neither
# capability and core budgets no audit gate run for it.
print(
    json.dumps(
        {
            "ecosystem": "maven",
            "capabilities": [],
            "updates": updates,
            "unmanageable": unmanageable,
            "notes": notes,
        },
        indent=2,
    )
)
PY
