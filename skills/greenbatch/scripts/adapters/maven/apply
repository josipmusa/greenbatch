#!/usr/bin/env bash
# Applies Maven updates using the lever that actually controls each version.
#
# Usage: apply <repo-dir> <element-id>...
#   element-id := property:<name>=<version>
#               | dependency:<groupId:artifactId>=<version>
#               | parent=<version>
#
# Exit: 0 applied; 2 tool failure or malformed id; 4 nothing changed
#
# The id syntax is this adapter's private business - core copies the ids out of
# the facts JSON and hands them straight back. Every goal pins the exact
# discovered version rather than re-resolving "latest", so what gets applied is
# what was planned and reported even if a new release lands mid-run.
set -euo pipefail

repo="$1"
shift
[ $# -gt 0 ] || { echo "usage: apply <repo-dir> <element-id>..." >&2; exit 2; }

cd "$repo"

VERSIONS_PLUGIN="${VERSIONS_PLUGIN:-org.codehaus.mojo:versions-maven-plugin:2.19.1}"
MVN="./mvnw"
[ -x "$MVN" ] || MVN="mvn"

specs=("$@")
before=$(git hash-object pom.xml)
log=$(mktemp)
trap 'rm -f "$log"' EXIT

for spec in "${specs[@]}"; do
  goal=()
  case "$spec" in
    property:*)
      body="${spec#property:}"
      goal=("${VERSIONS_PLUGIN}:set-property"
        -Dproperty="${body%%=*}" -DnewVersion="${body#*=}")
      ;;
    dependency:*)
      body="${spec#dependency:}"
      goal=("${VERSIONS_PLUGIN}:use-dep-version"
        -Dincludes="${body%%=*}" -DdepVersion="${body#*=}" -DforceVersion=true)
      ;;
    parent=*)
      # update-parent takes a version range; [x] pins that exact version.
      goal=("${VERSIONS_PLUGIN}:update-parent"
        -DparentVersion="[${spec#parent=}]" -DforceUpdate=true)
      ;;
    *)
      echo "maven/apply: unrecognized element id '$spec'" >&2
      exit 2
      ;;
  esac

  if ! "$MVN" -B -q "${goal[@]}" -DgenerateBackupPoms=false >"$log" 2>&1; then
    echo "maven/apply: failed applying '$spec':" >&2
    tail -20 "$log" >&2
    exit 2
  fi
done

after=$(git hash-object pom.xml)
if [ "$before" = "$after" ]; then
  echo "maven/apply: pom.xml unchanged - wrong lever or no match for: ${specs[*]}" >&2
  exit 4
fi

# Report what the pom NOW says, read back out of the file rather than echoed
# from the element ids. A goal that reports success while writing a different
# version - or writing nothing for one id in a multi-element batch - is exactly
# the kind of silent drift the report must never inherit. Conformance asserts
# these versions match what discovery offered.
IDS="${specs[*]}" python3 - pom.xml <<'PY'
import json, os, re, sys
import xml.etree.ElementTree as ET

NS = {"m": "http://maven.apache.org/POM/4.0.0"}
root = ET.parse(sys.argv[1]).getroot()


def text(node, tag):
    child = node.find(f"m:{tag}", NS)
    return child.text.strip() if child is not None and child.text else None


properties = {}
props = root.find("m:properties", NS)
if props is not None:
    for node in props:
        name = re.sub(r"^\{.*\}", "", node.tag)
        properties[name] = (node.text or "").strip()

declared = {}
for xpath in (
    "m:dependencies/m:dependency",
    "m:dependencyManagement/m:dependencies/m:dependency",
    "m:build/m:plugins/m:plugin",
    "m:build/m:pluginManagement/m:plugins/m:plugin",
):
    for node in root.findall(xpath, NS):
        artifact = text(node, "artifactId")
        if artifact:
            declared.setdefault(f"{text(node, 'groupId')}:{artifact}", text(node, "version"))

parent = root.find("m:parent", NS)
parent_version = text(parent, "version") if parent is not None else None


def resolve(version):
    """A ${property} reference read back through the properties block."""
    if not version:
        return None
    m = re.fullmatch(r"\$\{(.+)\}", version.strip())
    return properties.get(m.group(1)) if m else version.strip()


applied = []
for spec in os.environ["IDS"].split():
    if spec.startswith("property:"):
        name = spec[len("property:") :].split("=", 1)[0]
        applied.append({"id": spec, "name": name, "to": properties.get(name)})
    elif spec.startswith("dependency:"):
        ga = spec[len("dependency:") :].split("=", 1)[0]
        applied.append({"id": spec, "name": ga, "to": resolve(declared.get(ga))})
    elif spec.startswith("parent="):
        name = f"{text(parent, 'groupId')}:{text(parent, 'artifactId')}" if parent is not None else "parent"
        applied.append({"id": spec, "name": name, "to": parent_version})

print(json.dumps({"applied": applied}, indent=2))
PY
